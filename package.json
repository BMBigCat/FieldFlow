{
  "name": "fieldflow",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @fieldflow/api dev",
    "dev:web": "pnpm --filter @fieldflow/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "packageExtensions": {
      "react-router-dom@6.30.4": {
        "dependencies": {
          "@types/react": "18.3.31"
        }
      },
      "@tanstack/react-query@5.101.4": {
        "dependencies": {
          "@types/react": "18.3.31"
        }
      },
      "react-native-svg@15.15.4": {
        "dependencies": {
          "@types/react": "19.2.18"
        }
      }
    }
  }
}
