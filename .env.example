# Supabase project settings (dashboard > Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (dashboard > Project Settings > Database)
# Used by apps/api for direct SQL (health check, future query layer)
DATABASE_URL=

# apps/api
API_PORT=3000

# apps/web (Vite requires the VITE_ prefix to be exposed to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000
