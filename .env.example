# Supabase project settings (dashboard > Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (dashboard > Project Settings > Database)
# Used by apps/api for direct SQL (health check, future query layer)
DATABASE_URL=

# apps/api
API_PORT=3000

# Upstash Redis (dashboard > your database > "Redis Connect" > TLS URL).
# Powers BullMQ queues for recurring maintenance + job reminders (build plan §6).
REDIS_URL=

# Optional — invoice email send (build plan §5). Without these, POST
# /invoices/:id/send still generates the PDF and marks the invoice sent,
# but reports email.sent=false instead of actually delivering it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# apps/web (Vite requires the VITE_ prefix to be exposed to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000
